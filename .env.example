# Tanpa Entra: unduh Excel / Power Automate → upload di Daftar Hadir
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_MEALS_EXCEL_URL=https://tmtgroup.sharepoint.com/:x:/t/SHESangatta/IQBwVmoHHyU7T4k-lNLeFSOFAfmyAXEJUiKJVpv3pUzfKvE?e=v2hzhK
# Alias lama (masih didukung): SHAREPOINT_TECH_EXCEL_URL

# WhatsApp (Fonnte) — notifikasi handover ke grup operasional
# Token dari dashboard Fonnte (jangan commit token asli)
FONNTE_TOKEN=
# ID grup WA, contoh: 120363xxxxxxxxxx@g.us
FONNTE_GROUP_ID=
# Alternatif jika ID belum diketahui: cocokkan nama grup (fetch list sekali jika perlu)
