AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=
# LAN hostname for local server (optional)
HOSTNAME=
# HTTPS so Chrome/Edge can install the service worker (offline refresh).
# AUTH_URL https://... enables TLS automatically. Set TLS_ENABLE=0 to force HTTP.
TLS_ENABLE=
# TLS_CERT=certs/lan-cert.pem
# TLS_KEY=certs/lan-key.pem
# Optional Auth.js flag (trustHost already true in code)
AUTH_TRUST_HOST=
# URL publik untuk tautan WhatsApp (default: AUTH_URL)
APP_PUBLIC_URL=

# Production MySQL (Hostinger Remote MySQL hostname, NOT phpMyAdmin auth-db*)
# DATABASE_URL=mysql://USER:PASSWORD@srv1858.hstgr.io:3306/u925538922_tu_prima

# Local MySQL
DATABASE_URL=

# Microsoft Graph → sync kehadiran Meals Request (Daftar Hadir)
# Compare: No. ID Badge = SN / Pernr
# Aturan: ada di meals → available; tidak ada → offline (busy di-skip)
# App Entra: Files.Read.All atau Sites.Read.All (+ admin consent)
# Tanpa Entra: unduh Excel / Power Automate → upload di Daftar Hadir
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Alias lama (masih didukung): SHAREPOINT_TECH_EXCEL_URL

# WhatsApp (Fonnte) — notifikasi handover ke grup operasional
# Token dari dashboard Fonnte (jangan commit token asli)
FONNTE_TOKEN=
# ID grup WA, contoh: 120363xxxxxxxxxx@g.us
FONNTE_GROUP_ID=
# Alternatif jika ID belum diketahui: cocokkan nama grup (fetch list sekali jika perlu)
FONNTE_GROUP_NAME=
# Opsional: false untuk menonaktifkan tanpa menghapus token
FONNTE_ENABLED=true
# Kirim juga ke nomor HP foreman pada "Ditujukan kepada" (default: true)
FONNTE_NOTIFY_FOREMAN=true
